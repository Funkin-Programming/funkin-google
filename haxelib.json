{
"name": "funkin-google",
"url": "https://github.com/Funkin-Programming/funkin-google",
"license": "MIT",
"tags": [
"fnf",
"friday-night-funkin",
"google",
"firebase",
"cloud",
"save",
"mobile",
"android",
"ios",
"haxe",
"openfl",
"flixel"
],
"description": "Advanced Google & Firebase integration module for Friday Night Funkin' engines with login, cloud save, realtime sync, and mobile support.",
"version": "2.0.0",
"classPath": "source",
"releasenote": "Added Firebase support, extraParams configuration, and automatic mobile setup.",
"contributors": [
"Funkin-Programming",
"Community"
],

"dependencies": {
"haxe": "",
"openfl": ">=9.3.0",
"lime": ">=8.0.0",
"flixel": ">=5.0.0",
"flixel-addons": "",
"flixel-ui": "",
"hscript": "",
"json2object": "",
"thx.core": ""
},

"extraParams": {
"google": {
"enabled": true,
"clientId": "",
"clientSecret": "",
"redirectUri": "com.funkin.google:/oauth2redirect",
"scopes": [
"profile",
"email",
"https://www.googleapis.com/auth/drive.appdata"
]
},

"firebase": {
  "enabled": true,
  "apiKey": "",
  "authDomain": "",
  "projectId": "",
  "storageBucket": "",
  "messagingSenderId": "",
  "appId": "",
  "databaseURL": "",
  "autoLogin": true,
  "autoSync": true,
  "offlineCache": true
},

"mobile": {
  "android": {
    "googleServicesJson": "android/app/google-services.json",
    "enablePlayServices": true
  },
  "ios": {
    "googleServiceInfoPlist": "ios/Runner/GoogleService-Info.plist",
    "enableSignIn": true
  }
},

"cloudSave": {
  "enabled": true,
  "autoUpload": true,
  "autoDownload": true,
  "conflictStrategy": "latest"
},

"debug": {
  "enabled": false,
  "logAuth": true,
  "logSync": true
}

}
}
